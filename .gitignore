runs/**/final-adapter/
runs/**/checkpoint-*/

.DS_Store
.ipynb_checkpoints/

# Secrets — never commit. The OpenAI/Anthropic keys live here.
.env
.env.*
!.env.example
*.key
secrets.json

# Raw scraped feed + batch bookkeeping: large, regenerable via
# tools/fetch_shopify.py, and third-party product copy. The frozen eval set was
# committed until the terms audit landed; its labels are now published as
# data/eval_300/eval-labels.jsonl and its prose is not. See data/README.md.
data/raw/feed.jsonl
data/raw/labeled.jsonl
data/raw/batch_state.json

# --- merchant corpus: collected, not redistributed -------------------------
# 4,000 apparel listings from public Shopify endpoints. The Run 2 terms audit
# found 16 of 20 candidate stores prohibit that access and none approve it, and
# redistribution is a stronger act than access. Labels are published; the
# retailers' prose is not. See data/README.md.
data/train_weak.jsonl
data/train_weak_sft_scored.jsonl
data/train_weak_grpo_cap4.jsonl
data/train_weak_grpo_cap4_sft_train_v1.jsonl
data/train_weak_grpo_smoke_v1.jsonl
data/eval_300/eval.jsonl
data/eval_candidates.jsonl
data/grpo_run2_causal_schedule_v1.jsonl
data/probe_100.jsonl

# Review working files that carry merchant prose. Same position as the corpus
# above: the decisions are published, the retailers' copy is not. Regenerate
# with scripts/build_dataset.py and labeling/blind_audit.py.
data/review/review_queue.csv
data/review/review_queue_core.csv
data/review/blind_audit.csv
